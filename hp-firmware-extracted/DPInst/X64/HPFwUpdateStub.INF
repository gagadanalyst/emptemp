
[Version]
Signature="$Windows NT$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
CatalogFile=HPFwUpdateStub.CAT
DriverVer=09/08/2015, 1.0.0.1
;====================================================

[DestinationDirs]
; By default, files will be copied to \windows\system.
DefaultDestDir=11

[ControlFlags]
; Remove comment from this line if all devices are PnP.
ExcludeFromSelect=*

[Manufacturer]
%Mfg%=Models,NTamd64.6.0,NTamd64.6.1,NTamd64.6.2,NTamd64.6.3,NTx86.5.1,NTx86.6.0,NTx86.6.1,NTx86.6.2,NTx86.6.3,NTamd64.5.2

; Windows 2K is not supported
;[Models]
;; ; No support for Windows 2000
;WeberMid
; Windows XP
[Models.NTx86.5.1]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

[Models.NTamd64.5.2]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

[Models.NTx86.6.0]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

[Models.NTx86.6.1]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

[Models.NTx86.6.2]
; Skip Windows 8

[Models.NTx86.6.3]
; Skip Windows 8.1

; Windows x64
[Models.NTamd64.6.0]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

; Windows x64
[Models.NTamd64.6.1]
"HP Fw Update(REST_WinUSB)"=DMR.USB.1, USB\VID_03F0&PID_FF53&MI_00
"HP Fw Update(FwUpdate_REST_WinUSB)"=DMR.USB.2, USB\VID_03F0&PID_FF53&MI_01

; Windows x64
[Models.NTamd64.6.2]
; Skip Windows 8

; Windows x64
[Models.NTamd64.6.3]
; Skip Windows 8.1


; *****************************************************************************************
;           Windows XP (Whistler) and later
; *****************************************************************************************

[DMR.Usb.1]
Include=sti.inf
Needs=STI.USBSection
SubClass=StillImage
DeviceType=1
Capabilities=0x0
FeatureScore=00
AddReg=DMR.UsbReg.1
CopyFiles=Nothing

[DMR.Usb.2]
Include=sti.inf
Needs=STI.USBSection
SubClass=StillImage
DeviceType=1
Capabilities=0x0
FeatureScore=00
AddReg=DMR.UsbReg.2
CopyFiles=Nothing

[DMR.Usb.1.Services]
Include=sti.inf
Needs=STI.USBSection.Services

[DMR.Usb.2.Services]
Include=sti.inf
Needs=STI.USBSection.Services

[DMR.Usb.1.HW]
AddReg=REST_WinUSB.Reg

[DMR.Usb.2.HW]
AddReg=FWUpdate_REST_WinUSB.Reg

[REST_WinUSB.Reg]
HKR,,REST_WinUSB,0x00010001,0x1

[FwUpdate_REST_WinUSB.Reg]
HKR,,FwUpdate_REST_WinUSB,0x00010001,0x1

[DMR.UsbReg.1]
; This all depends on which kernel services you need
; Hardware configuration is not known
HKR,,HardwareConfig,1,1
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,"usbscan.sys"

[DMR.UsbReg.2]
; This all depends on which kernel services you need
; Hardware configuration is not known
HKR,,HardwareConfig,1,1
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,"usbscan.sys"

[SourceDisksNames]
1 = %CD%,,,

[SourceDisksFiles]

[Nothing]

[Strings]
; Always put strings down here so they can be easily localized to
; other languages.

Provider="Hewlett-Packard"
Mfg="Hewlett-Packard"
CD="hp cd"

